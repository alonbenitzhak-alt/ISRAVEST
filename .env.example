# ─── Supabase (Optional for future features) ─────────────────────────────────
# Project URL and anon key from: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# ─── Site ─────────────────────────────────────────────────────────────────────
# Full URL of the deployed site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://hapoelmuseum.com

# ─── Analytics ───────────────────────────────────────────────────────────────
# Google Analytics 4 property ID for tracking page views and user interactions
# Get this from: https://analytics.google.com → Admin → Property Settings
NEXT_PUBLIC_GA_ID=
